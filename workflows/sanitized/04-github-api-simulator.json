    {
      "id": "48369523-0735-4e82-a57e-6f6ee2edd268",
      "name": "Build Fixture",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        -128
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst {\n  resource,\n  username,\n  scenario,\n  page,\n  attempt,\n  request_headers,\n  request_url,\n} = input;\n\nconst nowEpoch = Math.floor(Date.now() / 1000);\n\nconst requestId =\n  `P01-${resource.toUpperCase()}-${scenario.toUpperCase()}-${attempt}`;\n\n\n// --------------------------------------------------\n// Helpers\n// --------------------------------------------------\n\nfunction profileFixture() {\n  return {\n    login: username,\n    id: 1001,\n    node_id: 'P01_USER_1001',\n    avatar_url: 'https://example.invalid/avatar.png',\n    html_url: `https://github.com/${username}`,\n    type: 'User',\n    name: 'P01 Test User',\n    public_repos: 3,\n  };\n}\n\n\nfunction repo(id, name) {\n  return {\n    id,\n    name,\n    full_name: `${username}/${name}`,\n    owner: {\n      login: username,\n    },\n    private: false,\n    html_url: `https://github.com/${username}/${name}`,\n    visibility: 'public',\n  };\n}\n\n\nfunction repositoryFixture(currentPage) {\n\n  if (currentPage === 1) {\n    return [\n      repo(2001, 'project-alpha'),\n      repo(2002, 'project-beta'),\n    ];\n  }\n\n  if (currentPage === 2) {\n    return [\n      repo(2003, 'project-gamma'),\n    ];\n  }\n\n  return [];\n}\n\n\nfunction successBody() {\n  return resource === 'profile'\n    ? profileFixture()\n    : repositoryFixture(page);\n}\n\n\n// --------------------------------------------------\n// Default response\n// --------------------------------------------------\n\nlet statusCode = 200;\nlet body = successBody();\n\nlet rateLimitLimit = '60';\nlet rateLimitRemaining = '57';\nlet rateLimitReset = String(nowEpoch + 3600);\n\nlet retryAfter = null;\nlet link = null;\n\n\n// --------------------------------------------------\n// Scenario\n// --------------------------------------------------\n\nswitch (scenario) {\n\n  case 'happy':\n    break;\n\n\n  case 'unauthorized':\n\n    statusCode = 401;\n\n    body = {\n      message: 'Bad credentials',\n    };\n\n    break;\n\n\n  case 'forbidden':\n\n    statusCode = 403;\n\n    rateLimitRemaining = '100';\n\n    body = {\n      message: 'Resource not accessible by integration',\n    };\n\n    break;\n\n\n  case 'primary_rate_limit':\n\n    if (attempt === 0) {\n\n      statusCode = 403;\n\n      rateLimitRemaining = '0';\n\n      // curto de propósito para teste\n      rateLimitReset = String(nowEpoch + 2);\n\n      body = {\n        message: 'API rate limit exceeded',\n      };\n    }\n\n    break;\n\n\n  case 'secondary_rate_limit':\n\n    if (attempt === 0) {\n\n      statusCode = 429;\n\n      retryAfter = '2';\n\n      body = {\n        message:\n          'You have exceeded a secondary rate limit.',\n      };\n    }\n\n    break;\n\n\n  case 'server_error':\n\n    statusCode = 500;\n\n    body = {\n      message: 'Internal Server Error',\n    };\n\n    break;\n\n\n  case 'timeout':\n\n    // O Wait anterior já causou o comportamento\n    // de timeout. Caso o cliente continue conectado,\n    // respondemos normalmente.\n    statusCode = 200;\n    body = successBody();\n\n    break;\n\n\n  case 'page2_error':\n\n    if (resource === 'repos' && page === 2) {\n      statusCode = 500;\n      body = { message: 'Internal Server Error on repository page 2' };\n    }\n    break;\n\n  case 'invalid_payload':\n\n    statusCode = 200;\n\n    if (resource === 'profile') {\n\n      // Perfil válido: o caso exercita a validação de repositórios.\n      body = profileFixture();\n\n    } else {\n\n      // owner.login propositalmente ausente\n      body = [\n        {\n          id: 2999,\n          name: 'invalid-repository',\n          full_name: `${username}/invalid-repository`,\n          owner: {},\n          visibility: 'public',\n        },\n      ];\n    }\n\n    break;\n\n\n  default:\n\n    statusCode = 400;\n\n    body = {\n      message: `Unknown simulator scenario: ${scenario}`,\n    };\n}\n\n\n// --------------------------------------------------\n// Pagination\n// --------------------------------------------------\n\nif (\n  statusCode === 200 &&\n  resource === 'repos' &&\n  page === 1 &&\n  scenario !== 'invalid_payload'\n) {\n\n  let baseUrl = request_url;\n\n  // fallback caso webhookUrl não esteja disponível\n  if (!baseUrl) {\n\n    const headers = request_headers ?? {};\n\n    const proto =\n      String(\n        headers['x-forwarded-proto'] ?? 'http'\n      )\n        .split(',')[0]\n        .trim();\n\n    const host =\n      headers['x-forwarded-host'] ??\n      headers.host ??\n      'localhost:5678';\n\n    baseUrl =\n      `${proto}://${host}` +\n      `webhook-test/3da72337-4263-4f71-bbb2-a8c8dea89093/p01/github/users/` +\n      `${encodeURIComponent(username)}/repos`;\n    \n  }\n\n  baseUrl = String(baseUrl).split('?')[0];\n  console.log(baseUrl)\n  console.log('log')\n\n  \n  link =\n    `<${baseUrl}?scenario=${encodeURIComponent(scenario)}&page=2&attempt=${attempt}>; rel=\"next\"`;\n}\n\n\n// --------------------------------------------------\n// Output\n// --------------------------------------------------\n\nreturn [\n  {\n    json: {\n      ...input,\n\n      response: {\n        status_code: statusCode,\n\n        body,\n\n        headers: {\n          content_type: 'application/json',\n          request_id: requestId,\n\n          rate_limit_limit: rateLimitLimit,\n          rate_limit_remaining: rateLimitRemaining,\n          rate_limit_reset: rateLimitReset,\n\n          retry_after: retryAfter,\n          link: link\n        },\n      },\n    },\n  },\n];"
      }
    },
