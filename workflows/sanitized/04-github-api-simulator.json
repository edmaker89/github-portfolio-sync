      {
        "id": "bc51d6ac-9523-4416-8136-6be1032a5ac6",
        "name": "Normalize Test Request",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          16,
          -128
        ],
        "parameters": {
          "jsCode": "const input = $input.first().json;\n\nconst query = input.query ?? {};\nconst params = input.params ?? {};\nconst headers = input.headers ?? {};\n\nconst allowedScenarios = [\n  'happy',\n  'unauthorized',\n  'forbidden',\n  'primary_rate_limit',\n  'secondary_rate_limit',\n  'server_error',\n  'timeout',\n  'invalid_payload',\n  'page2_error',\n];\n\nconst scenario = String(query.scenario ?? 'happy')\n  .trim()\n  .toLowerCase();\n\nconst page = Math.max(\n  1,\n  Number.parseInt(query.page ?? '1', 10) || 1\n);\n\nconst attempt = Math.max(\n  0,\n  Number.parseInt(query.attempt ?? '0', 10) || 0\n);\n\nreturn [\n  {\n    json: {\n      resource: input.resource,\n\n      username: String(params.username ?? 'octocat'),\n\n      scenario,\n      scenario_valid: allowedScenarios.includes(scenario),\n\n      page,\n      attempt,\n\n      request_headers: headers,\n\n      // Em versões/configurações onde o Webhook expõe a URL,\n      // conseguimos reutilizá-la para montar o Link da paginação.\n      request_url: input.webhookUrl ?? null,\n    },\n  },\n];"
        }
      },
